@using App.Domain.Core.Entites.User
@using App.Domain.Core.Helpers
@using Microsoft.AspNetCore.Identity
   @inject SignInManager<AppUser> SignInManager


<!DOCTYPE html>
<html lang="fa">

<head>
    <!-- Meta Data -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Goodup -  HTML</title>

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="assets/img/favicon.png">

    <!-- Custom CSS -->
    <link href="/assets/css/styles.css" rel="stylesheet">

    <script src="/assets/js/jquery.min.js"></script>
    <script src="/assets/js/slick.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body dir="rtl">

    <!-- ============================================================== -->
    <!-- Preloader - style you can find in spinners.css -->
    <!-- ============================================================== -->
    <div class="preloader"></div>

    <!-- ============================================================== -->
    <!-- Main wrapper - style you can find in pages.scss -->
    <!-- ============================================================== -->
    <div id="main-wrapper">

        <!-- ============================================================== -->
        <!-- Top header  -->
        <!-- ============================================================== -->
        <!-- Start Navigation -->
        <div class="header header-light dark-text">
            <div class="container">
                <nav id="navigation" class="navigation navigation-landscape">
                    <div class="nav-header">
                        <a class="nav-brand" href="#">
                            <img src="~/-2147483648_-210427.jpg" class="logo" alt="" />
                        </a>
                        <div class="nav-toggle"></div>
                        <div class="mobile_nav">
                            <ul>
                                <li>
                                    <a asp-page="/login" data-bs-toggle="modal" data-bs-target="#login" class="theme-cl fs-lg">
                                        <i class="lni lni-user"></i>
                                    </a>
                                </li>
                                <li>
                                    <a asp-page="/categories/index" class="crs_yuo12 w-auto text-white theme-bg">
                                        <span class="embos_45"><i class="fas fa-plus ms-2"></i>افزودن سفارش</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="nav-menus-wrapper" style="transition-property: none;">
                        <ul class="nav-menu">

                            <li><a asp-page="/index">صفحه اصلی</a></li>
                            <li><a asp-page="/categories/index">دسته بندی خدمات</a></li>

                            @if (SignInManager.IsSignedIn(User))
                            {
                                <li>
                                    <a>پنل کاربری</a>
                                    <ul class="nav-dropdown nav-submenu">
                                        @if (User.IsInRole("Customer"))
                                        {
                                            <li><a asp-page="/menu/dashboard" asp-area="customer"><i class="lni lni-dashboard ms-2"></i>داشبورد</a></li>
                                            <li><a asp-page="/menu/myorders" asp-area="customer"><i class="lni lni-files ms-2"></i>سفارش های من</a></li>
                                            <li><a asp-page="/categories/index"><i class="lni lni-add-files ms-2"></i>ثبت سفارش</a></li>
                                        }
                                        else if (User.IsInRole("Expert"))
                                        {
                                            <li><a asp-page="/menu/dashboard" asp-area="expert"><i class="lni lni-dashboard ms-2"></i>داشبورد</a></li>
                                            <li><a asp-page="/menu/reservations" asp-area="expert"><i class="lni lni-files ms-2"></i>سفارش های رزرو</a></li>
                                            <li><a asp-page="/menu/accepted" asp-area="expert"><i class="lni lni-files ms-2"></i>سفارش های پذیرفته شده</a></li>
                                            <li><a asp-page="/menu/Comments" asp-area="expert"><i class="lni lni-envelope ms-2"></i> نظرات کاربران</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a>پنل کاربری</a>
                                    <ul class="nav-dropdown nav-submenu">
                                        <li><a asp-page="/login"><i class="lni lni-dashboard ms-2"></i>داشبورد</a></li>
                                        <li><a asp-page="/login"><i class="lni lni-files ms-2"></i>سفارش های من</a></li>
                                        <li><a asp-page="/login"><i class="lni lni-add-files ms-2"></i>ثبت سفارش</a></li>
                                    </ul>
                                </li>
                            }

                            <li>
                                <a>صفحات</a>
                                <ul class="nav-dropdown nav-submenu">
                                    <li><a asp-page="/register">ثبت نام</a></li>
                                    <li><a asp-page="/login">ورود</a></li>
                                    <li><a asp-page="/Rules">شرایط و قوانین</a></li>
                                    <li><a asp-page="/soalat">سوالات متداول</a></li>
                                </ul>
                            </li>
                        </ul>

                        <ul class="nav-menu nav-menu-social align-to-left">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <li class="nav-item d-flex align-items-center gap-3">
                                    <span class="text-dark">خوش آمدید @User.Identity?.Name</span>

                                    <a asp-page="/logout" class="ft-bold btn btn-link text-dark">
                                        <i class="fas fa-sign-out-alt ms-1 theme-cl"></i>خروج
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-area="Admin" asp-page="/Index" class="btn btn-primary btn-sm">
                                            <i class="fas fa-cogs ms-1"></i>پنل ادمین
                                        </a>
                                    }
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a asp-page="/Login" class="ft-bold">
                                        <i class="fas fa-sign-in-alt ms-1 theme-cl"></i>ورود
                                    </a>
                                </li>
                                <li class="add-listing">
                                    <a asp-page="/categories/index">
                                        <i class="fas fa-plus ms-2"></i>ثبت سفارش
                                    </a>
                                </li>
                            }
                        </ul>

                    </div>
                </nav>

            </div>
        </div>

        <!-- End Navigation -->
        <div class="clearfix"></div>
        <!-- ============================================================== -->
        <!-- Top header  -->
        <!-- ============================================================== -->

        <div class="container">
            @RenderBody()
        </div>

        <!-- ============================ Footer Start ================================== -->
        <footer class="light-footer skin-light-footer style-2">
            <div class="footer-middle">
                <div class="container">
                    <div class="row">

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12">
                            <div class="footer_widget">
                                <img src="/assets/img/logo.png" class="img-footer small mb-2" alt="" />

                                <div class="address mt-2">
                                    ایران، تهران، میدان آزادی جنب مترو شادمان<br> کوچه شکوفه پلاک 8
                                </div>
                                <div class="address mt-3">
                                    09320000000<br>support@Goodup.com
                                </div>
                                <div class="address mt-2">
                                    <ul class="list-inline">
                                        <li class="list-inline-item"><a href="#" class="theme-cl"><i class="lni lni-facebook-filled"></i></a></li>
                                        <li class="list-inline-item"><a href="#" class="theme-cl"><i class="lni lni-twitter-filled"></i></a></li>
                                        <li class="list-inline-item"><a href="#" class="theme-cl"><i class="lni lni-youtube"></i></a></li>
                                        <li class="list-inline-item"><a href="#" class="theme-cl"><i class="lni lni-instagram-filled"></i></a></li>
                                        <li class="list-inline-item"><a href="#" class="theme-cl"><i class="lni lni-linkedin-original"></i></a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-12">
                            <div class="footer_widget">
                                <h4 class="widget_title">راهنمای سایت</h4>
                                <ul class="footer-menu">
                                    <li><a href="#">لیست آگهی</a></li>
                                    <li><a href="#">لیست آگهی دهنده</a></li>
                                    <li><a href="#">افزودن آگهی</a></li>
                                    <li><a href="#">تماس با ما</a></li>
                                    <li><a href="#">پیشخوان</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-12">
                            <div class="footer_widget">
                                <h4 class="widget_title">حساب کاربری</h4>
                                <ul class="footer-menu">
                                    <li><a href="#">سایر دسته بندی</a></li>
                                    <li><a href="#">لینک پرداخت</a></li>
                                    <li><a href="#">لیست علاقه مندی</a></li>
                                    <li><a href="#">تنظیمات</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-12">
                            <div class="footer_widget">
                                <h4 class="widget_title">درباره شرکت</h4>
                                <ul class="footer-menu">
                                    <li><a href="#">درباره ما</a></li>
                                    <li><a href="#">وظایف ما</a></li>
                                    <li><a href="#">کارشناسان</a></li>
                                    <li><a href="#">پکیج ها</a></li>
                                    <li><a href="#">پروفایل من</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-12">
                            <div class="footer_widget">
                                <h4 class="widget_title">لینک های مفید</h4>
                                <ul class="footer-menu">
                                    <li><a href="#">نقشه سایت</a></li>
                                    <li><a href="#">حریم شخصی</a></li>
                                    <li><a href="#">تماس با ما</a></li>
                                    <li><a href="#">سوالات متداول</a></li>
                                    <li><a href="#">قوانین سایت</a></li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="footer-bottom br-top">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-12 col-md-12 text-center">
                            <p class="mb-0">© 2022 Goodup ارائه شده در سایت <a href="https://rtl-theme.com/">راست چین</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- ============================ Footer End ================================== -->


        <a id="tops-button" class="top-scroll" title="Back to top" href="#"><i class="ti-arrow-up"></i></a>


    </div>
    <!-- ============================================================== -->
    <!-- End Wrapper -->
    <!-- ============================================================== -->
    <!-- ============================================================== -->
    <!-- All Jquery -->
    <!-- ============================================================== -->
    <script src="/assets/js/jquery.min.js"></script>
    <script src="/assets/js/popper.min.js"></script>
    <script src="/assets/js/bootstrap.min.js"></script>
    <script src="/assets/js/slick.js"></script> <!-- ✅ Ensure this is included -->
    <script src="/assets/js/jquery.magnific-popup.min.js"></script>
    <script src="/assets/js/dropzone.js"></script>
    <script src="/assets/js/counterup.js"></script>
    <script src="/assets/js/lightbox.js"></script> <!-- ✅ Remove duplicate -->
    <script src="/assets/js/moment.min.js"></script>
    <script src="/assets/js/daterangepicker.js"></script>
    <script src="/assets/js/jQuery.style.switcher.js"></script>
    <script src="/assets/js/custom.js"></script> <!-- ✅ Keep this last -->
    <!-- ============================================================== -->
    <!-- This page plugins -->
    <!-- ============================================================== -->
    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>