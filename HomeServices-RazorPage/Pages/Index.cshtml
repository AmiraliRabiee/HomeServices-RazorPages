@page
@using App.Domain.Core.Contracts.AppService
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
@inject IHouseWorkAppService workAppService

<div class="preloader"></div>

<!-- ============================================================== -->
<!-- Main wrapper - style you can find in pages.scss -->
<!-- ============================================================== -->
<div id="main-wrapper">

    <!-- ============================================================== -->
    <!-- ======================= Home Banner ======================== -->
    <div class="home-banner home-8">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-11 col-lg-12 col-md-12 col-sm-12 col-12">
                    @if (TempData["PendingApproval"] != null)
                    {
                        <div class="alert alert-warning">
                            @TempData["PendingApproval"]
                        </div>
                    }

                    <div class="banner_caption text-center mb-5">
                        <h1 class="banner_title_xxl ft-bold text-light mb-1">دریافت خدمات و ثبت سفارش آنلاین</h1>
                        <p class="fs-lg ft-medium text-light">در کوتاه‌ترین زمان خدمات و کارشناس مورد نظر خود را کاوش کنید</p>
                    </div>

                    <!-- Search Form -->
                    <form method="post">
                        <div class="modernSearch">
                            <div class="fieldWrap">
                                <input type="text" class="form-control" name="ServiceInput" placeholder="نام خدمات را جستجو کنید" value="@Model.ServiceInput">
                                <i class="ico lni lni-search-alt"></i>
                            </div>
                            <div class="buttonBox">
                                <button type="submit" class="btn theme-bg">برو</button>
                            </div>
                        </div>
                    </form>

                    <!-- Search Results -->
                    @if (Model.IsSearchSubmitted)
                    {
                        <div id="searchResultsContainer" class="mt-5" style="max-height: 250px; overflow-y: auto;">
                            <h3 class="text-light">نتایج جستجو:</h3>
                            @if (Model.SearchResults != null && Model.SearchResults.Any())
                            {
                                <ul class="list-group">
                                    @foreach (var result in Model.SearchResults)
                                    {
                                        <li class="list-group-item">
                                            <a asp-page="/client/index" asp-route-id="@result.Id">
                                                <h6>@result.Title</h6>
                                                <h6>@result.FullName</h6>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-light">نتیجه‌ای یافت نشد.</p>
                            }
                        </div>
                    }

                </div>
            </div>
        </div>

        <div class="slider-banner hideDots">
            <div class="imgSlide">
                <div class="singleSlide"><img src="@Url.Content("~/assets/img/banner/technical.jpeg")" class="img" alt="Img Slide"></div>
                <div class="singleSlide"><img src="@Url.Content("~/assets/img/banner/laptop.jpg")" class="img" alt="Img Slide"></div>
                <div class="singleSlide"><img src="@Url.Content("~/assets/img/banner/health.jpg")" class="img" alt="Img Slide"></div>
                <div class="singleSlide"><img src="@Url.Content("~/assets/img/banner/hair.jpg")" class="img" alt="Img Slide"></div>
            </div>
            <img src="@Url.Content("~/assets/img/hero-curve.png")" alt="curve shape" class="position-absolute start-0 bottom-0 zindex-1 w-100">
        </div>
    </div>
    <!-- ======================= Home Banner ======================== -->
    <section class="space min white">
        <div class="row justify-content-center">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                <div class="sec_title position-relative text-center mb-3">
                    <!-- Reduced margin-bottom -->
                    <h4 class="ft-bold">انتخاب دسته بندی</h4>
                </div>
            </div>
        </div>
        <div class="Goodup-top-cates mt-3">
            <!-- Added margin-top -->
            <ul class="row align-items-center">
                @foreach (var category in Model.Cats)
                {
                    var countSerivce = await workAppService.GetServiceCount(category.Id);
                    <li class="col-xl-2 col-lg-3 col-md-4 col-sm-6 col-6">
                        <a asp-page="/Subcategories/index" asp-area="" asp-route-id="@category.Id" class="Goodup-catg-wrap">
                            <div>
                                @if (category.Title == "تاسیسات")
                                {
                                    <div class="Goodup-catg-icon"><i class="fas fa-house-damage"></i></div>
                                }
                                else if (category.Title == "نظافت")
                                {
                                    <div class="Goodup-catg-icon"><i class="fas fa-building"></i></div>
                                }
                                else if (category.Title == "زیبایی")
                                {
                                    <div class="Goodup-catg-icon"><i class="fas fa-basketball-ball"></i></div>
                                }
                                else if (category.Title == "تعمیرات اشیا")
                                {
                                    <div class="Goodup-catg-icon"><i class="fas fa-screwdriver"></i></div>
                                }
                                else if (category.Title == "خودرو")
                                {
                                    <div class="Goodup-catg-icon"><i class="fas fa-car-alt"></i></div>
                                }
                                else if (category.Title == "سلامت")
                                {
                                    <div class="Goodup-catg-icon"><i class="fas fa-stethoscope"></i></div>
                                }
                                else
                                {
                                    <i class="fas fa-question-circle"></i>
                                }
                            </div>
                            <div class="Goodup-tp-title"><h5>@category.Title</h5></div>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </section>
    <!-- ====================== Top Restaurents ==================== -->
    <section class="pt-0">
        <div class="container">

            <div class="row justify-content-center">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                    <div class="sec_title position-relative text-center mb-5">
                        <h4 class="text-muted mb-0">خدمات محبوب</h4>
                    </div>
                </div>
            </div>

            <div class="row align-items-center justify-content-center g-4">
                <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                    <div class="newlistslider">
                        @foreach (var work in Model.Works)
                        {
                            <!-- Single -->
                            <div class="single-list">
                                <div class="Goodup-grid-wrap">
                                    <div class="Goodup-grid-upper">
                                        <div class="Goodup-grid-thumb">
                                            <a href="" class="d-block text-center m-auto"><img src="@work.ImagePath" class="img-fluid" alt=""></a>
                                        </div>
                                    </div>
                                    <div class="Goodup-grid-fl-wrap">
                                        <div class="Goodup-caption px-3 py-2">
                                            <h4 class="mb-0 ft-medium medium"><a href="single-listing-detail-2.html" class="text-dark fs-md">@work.Title</a></h4>
                                            <div class="Goodup-location"><i class="fas fa-map-marker-alt ms-1 theme-cl"></i>سراسر کشور</div>
                                            <div class="Goodup-middle-caption mt-3">
                                                <p>@work.Description</p>
                                            </div>
                                        </div>
                                        <div class="Goodup-grid-footer py-2 px-3">
                                            <div class="Goodup-ft-first">
                                                <div class="Goodup-rating">
                                                    <div class="Goodup-pr-average high">پرتقاضا</div>
                                                </div>
                                            </div>
                                            <div class="Goodup-ft-last">
                                                <div class="Goodup-inline">
                                                    <div class="Goodup-bookmark-btn"><button type="button"><i class="lni lni-envelope position-absolute"></i></button></div>
                                                    <div class="Goodup-bookmark-btn"><button type="button"><i class="lni lni-heart-filled position-absolute"></i></button></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </section>
    <!-- ====================== Top Restaurents ==================== -->

    <section>
        <div class="container">
            <div class="row align-items-center justify-content-center g-4">
                <div class="row justify-content-center">
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                        <div class="sec_title position-relative text-center mb-5">
                            <h4 class="ft-bold">
                                سه قدم تا دریافت سرویس در محل
                            </h4>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-6">
                    <div class="topFeatures">
                        <div class="icoBox"><i class="fa-solid fa-magnifying-glass"></i><span class="num">01</span></div>
                        <div class="capText">
                            <h4 class="title">جستجو و انتخاب سرویس</h4>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6">
                    <div class="topFeatures">
                        <div class="icoBox"><i class="fa-regular fa-file-lines"></i><span class="num">02</span></div>
                        <div class="capText">
                            <h4 class="title">انجام مراحل ثبت سفارش</h4>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6">
                    <div class="topFeatures">
                        <div class="icoBox"><i class="fa-regular fa-circle-check"></i><span class="num">03</span></div>
                        <div class="capText">
                            <h4 class="title">دریافت سرویس در محل</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--------------------------------------->


    <section class="space bg-cover" style="background:#03343b url(assets/img/landing-bg.png) no-repeat;">
        <div class="container py-5">

            <div class="row justify-content-center">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                    <div class="sec_title position-relative text-center mb-5">
                        <h6 class="text-light">عضویت</h6>
                        <h3 class="ft-bold text-light ">برای شروع ثبت نام کنید</h3>
                    </div>
                </div>
            </div>

            <div class="row align-items-center justify-content-center">
                <div class="col-xl-7 col-lg-10 col-md-12 col-sm-12 col-12">
                    <form class="bg-white rounded p-1">
                        <div class="form-group mb-0 position-relative">
                            <button type="button" onclick="window.location.href='/register'" class="btn full-width btn-height bg-dark text-white fs-md">عضویت</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </section>



    <a id="tops-button" class="top-scroll" title="Back to top" href="#"><i class="ti-arrow-up"></i></a>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let results = document.querySelectorAll(".search-item");
            let resultsContainer = document.getElementById("searchResultsContainer");
            let currentIndex = 3;

            results.forEach((item, index) => {
                if (index >= currentIndex) item.classList.add("d-none");
            });

            resultsContainer.addEventListener("scroll", function () {
                let threshold = resultsContainer.scrollTop + resultsContainer.clientHeight;
                if (threshold >= resultsContainer.scrollHeight - 10) {
                    loadMoreResults();
                }
            });

            function loadMoreResults() {
                let remainingItems = results.length - currentIndex;
                let itemsToLoad = Math.min(3, remainingItems); 

                for (let i = 0; i < itemsToLoad; i++) {
                    if (results[currentIndex]) {
                        results[currentIndex].classList.remove("d-none");
                        currentIndex++;
                    }
                }
            }
        });
    </script>
}
