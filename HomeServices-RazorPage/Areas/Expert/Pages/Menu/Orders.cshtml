@page
@using HomeServices_RazorPage.Areas.Expert.Pages.Menu
@using Framework
@model OrdersModel
@{

}

<div class="goodup-dashboard-wrap gray px-4 py-5">
    <a class="mobNavigation" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="MobNav">
        <i class="fas fa-bars ms-2"></i>منو
    </a>
    <div class="collapse" id="MobNav">
        <div class="goodup-dashboard-nav sticky-top">
            <div class="goodup-dashboard-inner">
                <ul data-submenu-title="منو">
                    <li><a asp-page="ExpertDashboard"><i class="lni lni-dashboard ms-2"></i>داشبورد</a></li>
                    <li><a asp-page="orders"><i class="lni lni-files ms-2"></i>سفارش های رزرو</a></li>
                    <li><a asp-page="Comments"><i class="lni lni-envelope ms-2"></i> نظرات کاربران</a></li>
                </ul>
                <ul data-submenu-title="حساب کاربری">
                    <li><a asp-page="Profile"><i class="lni lni-user ms-2"></i> تنظیمات </a></li>
                    <li><a asp-page="/logout" asp-area=""><i class="lni lni-power-switch ms-2"></i>خروج</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="goodup-dashboard-content">
        <div class="dashboard-tlbar d-block mb-5">
            <div class="row">
                <div class="colxl-12 col-lg-12 col-md-12">
                    <h1 class="ft-medium fs-lg">لیست رزروها</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item text-muted"><a href="#">خانه</a></li>
                            <li class="breadcrumb-item text-muted"><a href="#">داشبورد</a></li>
                            <li class="breadcrumb-item"><a href="#" class="theme-cl">لیست رزروها</a></li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>

        <div class="dashboard-widg-bar d-block">
            <div class="row">
                <div class="col-xl-12 col-lg-12">
                    <div class="dashboard-list-wraps bg-white rounded mb-4">
                        <div class="dashboard-list-wraps-head br-bottom py-3 px-3">
                            <div class="dashboard-list-wraps-flx">
                                <h4 class="mb-0 ft-medium fs-md"><i class="fas fa-shopping-basket ms-2 theme-cl fs-sm"></i>لیست رزروها</h4>
                            </div>
                        </div>

                        <div class="dashboard-list-wraps-body py-3 px-3">
                            <div class="dashboard-bookings-wraps">
                                @foreach (var order in Model.OrderDtos)
                                {
                                    <!-- Single booking List -->
                                    <div class="dsd-single-bookings-wraps">
                                        <div class="dsd-single-book-thumb"><img src="@order.ImagePath" class="img-fluid circle" alt="" /></div>
                                        <div class="dsd-single-book-caption">
                                            <div class="dsd-single-book-title">
                                                <h5>@order.CustomerName <span class="bko-dates">@order.CreationDate.ToPersianString("dddd, dd MMMM yyyy")</span></h5>
                                            </div>
                                            <div class="dsd-single-descr">
                                                <div class="dsd-single-item"><span class="dsd-item-title">عنوان سرویس:</span><span class="dsd-item-info">@order.HouseWork</span></div>
                                                <div class="dsd-single-item"><span class="dsd-item-title">تاریخ اجرا:</span><span class="dsd-item-info">@order.CompletionDate.ToPersianString()</span></div>
                                                <div class="dsd-single-item"><span class="dsd-item-title">ساعت اجرا:</span><span class="dsd-item-info">@order.RunningTime</span></div>
                                                <div class="dsd-single-item"><span class="dsd-item-title">توضیحات:</span><span class="dsd-item-info">@order.Description</span></div>
                                            </div>

                                            <div class="dsd-single-book-footer" style="position: absolute; left: 10px; bottom: 10px;">
                                                <a asp-page="createsuggestion" asp-route-orderId="@order.Id" class="btn btn-aprd mr-1"><i class="fas fa-check-circle ms-1"></i>تایید</a>
@*                                                 <a href="javascript:void(0);" class="btn btn-reject mr-1"><i class="fas fa-trash ms-1"></i>رد کردن</a>
 *@                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
