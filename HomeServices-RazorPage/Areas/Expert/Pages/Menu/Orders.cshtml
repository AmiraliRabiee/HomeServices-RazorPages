@page
@using App.Domain.Core.Enum
@using HomeServices_RazorPage.Areas.Expert.Pages.Menu
@using Framework
@model OrdersModel
@using App.Domain.Core.Helpers
@{
}
<div class="goodup-dashboard-wrap gray px-4 py-5">
    <a class="mobNavigation" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="MobNav">
        <i class="fas fa-bars ms-2"></i>منو
    </a>
    <div class="collapse" id="MobNav">
        <div class="goodup-dashboard-nav sticky-top">
            <div class="goodup-dashboard-inner">
                <ul data-submenu-title="منو">
                    <li><a asp-page="Dashboard"><i class="lni lni-dashboard ms-2"></i>داشبورد</a></li>
                    <li><a asp-page="reservations"><i class="lni lni-files ms-2"></i>سفارش های رزرو</a></li>
                    <li><a asp-route-expertId="" asp-page="Comments"><i class="lni lni-envelope ms-2"></i> نظرات کاربران</a></li>
                </ul>
                <ul data-submenu-title="حساب کاربری">
                    <li><a asp-page="Profile"><i class="lni lni-user ms-2"></i> تنظیمات </a></li>
                    <li><a asp-page="/logout" asp-area=""><i class="lni lni-power-switch ms-2"></i>خروج</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="goodup-dashboard-content">
        <div class="goodup-dashboard-content">
            <div class="dashboard-tlbar d-block mb-5">
                <div class="row">
                    <div class="colxl-12 col-lg-12 col-md-12">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item text-muted"><a href="#">خانه</a></li>
                                <li class="breadcrumb-item text-muted"><a href="#">داشبورد</a></li>
                                <li class="breadcrumb-item text-muted"><a href="#">لیست رزروها</a></li>
                                <li class="breadcrumb-item"><a href="#" class="theme-cl">سفارش</a></li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>

            <div class="dashboard-widg-bar d-block">
                <div class="row">
                    <div class="col-xl-12 col-lg-12">
                        <div class="dashboard-list-wraps bg-white rounded mb-4">

                            <div class="dashboard-list-wraps-body py-3 px-3">
                                <div class="dashboard-bookings-wraps">
                                    <!-- Single booking List -->
                                    <div class="dsd-single-bookings-wraps">
                                        <div class="dsd-single-book-thumb">
                                            <a asp-page="content" asp-area="customer" asp-route-customerId="@Model.OrderDto.CustomerId">
                                                <img src="@(string.IsNullOrEmpty(Model.OrderDto.ImagePath) ? Url.Content("~/images/profiles/base (3).png") : Model.OrderDto.ImagePath)" />
                                            </a>
                                        </div>
                                        <div class="dsd-single-book-caption">
                                            <div class="dsd-single-book-title">
                                                <h5>
                                                    <a asp-page="content" asp-area="customer" asp-route-customerId="@Model.OrderDto.CustomerId">
                                                        @Model.OrderDto.CustomerName
                                                        <span class="bko-dates">ثبت شده : @Model.OrderDto.CreationDate.ToPersianString("dddd, dd MMMM yyyy")</span>
                                                    </a>
                                                </h5>
                                            </div>
                                            <div class="dsd-single-descr">
                                                <div class="dsd-single-item"><span class="dsd-item-title">عنوان سرویس:</span><span class="dsd-item-info">@Model.OrderDto.HouseWork</span></div>
                                                <div class="dsd-single-item"><span class="dsd-item-title">تاریخ اجرا:</span><span class="dsd-item-info">@Model.OrderDto.CompletionDate.ToPersianString()</span></div>
                                                <div class="dsd-single-item"><span class="dsd-item-title">ساعت اجرا:</span><span class="dsd-item-info">@Model.OrderDto.RunningTime</span></div>
                                                <div class="dsd-single-item"><span class="dsd-item-title">قیمت پایه:</span><span class="dsd-item-info">@Model.OrderDto.BasePrice تومان</span></div>
                                                <div class="dsd-single-item"><span class="dsd-item-title">آدرس:</span><span class="dsd-item-info">@Model.OrderDto.Address</span></div>
                                                <div class="dsd-single-item"><span class="dsd-item-title">توضیحات:</span><span class="dsd-item-info">@Model.OrderDto.Description</span></div>
                                            </div>
                                            @if (Model.OrderDto.IsConfrim == false)
                                            {
                                                <div class="dsd-single-book-footer" style="position: absolute; left: 10px; bottom: 10px;">
                                                    <a asp-page="createsuggestion" asp-route-orderId="@Model.OrderDto.Id" class="btn btn-aprd mr-1"><i class="fas fa-check-circle ms-1"></i>ثبت پیشنهاد</a>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex justify-content-between align-items-center mt-3">
                                                    <!-- Swapped: Bid Price on the left, Status on the right -->
                                                    <div class="dsd-single-item"><span class="dsd-item-title">قیمت پیشنهادی:</span><span class="dsd-item-info">@Model.SuggestPrice تومان</span></div>
                                                    <div>
                                                        @if (Model.OrderDto.StausService == StausServiceEnum.WaitingForService)
                                                        {
                                                            <div class="px-2 py-1 medium bg-secondary rounded text-white">@Model.OrderDto.StausService.GetEnumDisplayName()</div>
                                                        }
                                                        @if (Model.OrderDto.StausService == StausServiceEnum.Done)
                                                        {
                                                            <div class="px-2 py-1 medium bg-light-warning rounded text-warning">@Model.OrderDto.StausService.GetEnumDisplayName()</div>
                                                        }
                                                        @if (Model.OrderDto.StausService == StausServiceEnum.Payment)
                                                        {
                                                            <div class="px-2 py-1 medium bg-light-success rounded text-success">@Model.OrderDto.StausService.GetEnumDisplayName()</div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>