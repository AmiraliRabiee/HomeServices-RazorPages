@page
@using App.Domain.Core.Helpers
@using HomeServices_RazorPage.Areas.Expert.Pages.Menu
@model ProfileModel
@{
}
@section Styles {
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
}


<div class="goodup-dashboard-wrap gray px-4 py-5">
    <a class="mobNavigation" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="MobNav">
        <i class="fas fa-bars ms-2"></i>منو
    </a>
    <div class="collapse" id="MobNav">
        <div class="goodup-dashboard-nav sticky-top">
            <div class="goodup-dashboard-inner">
                <ul data-submenu-title="منو">
                    <li><a asp-page="Dashboard"><i class="lni lni-dashboard ms-2"></i>داشبورد</a></li>
                    <li><a asp-page="reservations"><i class="lni lni-files ms-2"></i>سفارش های رزرو</a></li>
                    <li><a asp-page="accepted"><i class="lni lni-files ms-2"></i>سفارش های فعال</a></li>

                    <li><a asp-route-expertId="" asp-page="Comments"><i class="lni lni-envelope ms-2"></i> نظرات کاربران</a></li>
                </ul>
                <ul data-submenu-title="حساب کاربری">
                    <li><a asp-page="Profile"><i class="lni lni-user ms-2"></i> تنظیمات </a></li>
                    <li><a asp-page="/logout" asp-area=""><i class="lni lni-power-switch ms-2"></i>خروج</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="goodup-dashboard-content">
        <div class="dashboard-tlbar d-block mb-5">
            <div class="row">
                <div class="colxl-12 col-lg-12 col-md-12">
                    <h1 class="ft-medium fs-lg">تنظیمات</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item text-muted"><a href="#">خانه</a></li>
                            <li class="breadcrumb-item text-muted"><a href="#">داشبورد</a></li>
                            <li class="breadcrumb-item"><a href="#" class="theme-cl">تنظیمات</a></li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>

        <form class="submit-form" method="post" enctype="multipart/form-data">
            <div class="dashboard-widg-bar d-block">
                <div class="row">
                    <div class="col-xl-3 col-lg-3 col-md-4 col-sm-12 order-xl-last order-lg-last order-md-last">
                        <div class="d-flex bg-white rounded px-3 py-3 mb-3">
                            <div class="dash-figure">
                                <div class="dash-figure-thumb">
                                    <img src="@Model.OnlineExpert.ImagePath" class="img-fluid rounded" alt="" />
                                </div>
                                <div class="upload-photo-btn">
                                    <div class="Uploadphoto" style="background:#03343b">
                                        <span><i class="fas fa-upload"></i> آپلود تصویر</span>
                                        <input asp-for="@Model.OnlineExpert.ExpertImage" type="file" class="upload">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <input type="hidden" asp-for="OnlineExpert.ImagePath" id="oldImagePath" />

                    <div class="col-xl-9 col-lg-9 col-md-8 col-sm-12">
                        <div class="dashboard-list-wraps bg-white rounded mb-4">
                            <div class="dashboard-list-wraps-body py-3 px-3">
                                <div class="row">
                                    <input type="hidden" asp-for="OnlineExpert.Id" />
                                    <input type="hidden" asp-for="UpdateUser.Id" />

                                    <div class="col-xl-6 col-lg-6 col-md-12">
                                        <div class="form-group">
                                            <label class="mb-1">نام</label>
                                            <input asp-for="OnlineExpert.FirstName" type="text" class="form-control rounded" />
                                        </div>
                                    </div>

                                    <div class="col-xl-6 col-lg-6 col-md-12">
                                        <div class="form-group">
                                            <label class="mb-1">نام خانوادگی</label>
                                            <input asp-for="OnlineExpert.LastName" type="text" class="form-control rounded" />
                                        </div>
                                    </div>

                                    <div class="col-xl-6 col-lg-6 col-md-12">
                                        <div class="form-group">
                                            <label class="mb-1">شهر</label>
                                            <select asp-for="OnlineExpert.CityId" class="form-select" required>
                                                @foreach (var city in Model.Cities)
                                                {
                                                    <option value="@city.Id">@city.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-xl-6 col-lg-6 col-md-12">
                                        <div class="form-group">
                                            <label class="mb-1">موجودی(تومان)</label>
                                            <input asp-for="OnlineExpert.Balance" type="text" class="form-control rounded" />
                                        </div>
                                    </div>

                                    <div class="col-xl-12 col-lg-12 col-md-12">
                                        <div class="form-group">
                                            <label class="mb-1">مهارت‌ها</label>
                                            <select class="js-example-basic-multiple form-control" name="houseWorkIds" multiple="multiple">
                                                @foreach (var houseWork in Model.HousWorks)
                                                {
                                                    <option value="@houseWork.Id" selected="@(Model.OnlineExpert.SelectedHouseWorkIds.Contains(houseWork.Id) ? "selected" : null)">
                                                        @houseWork.Title
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>


                                    <div class="col-12">
                                        <div class="form-group">
                                            <label class="mb-1">بیوگرافی</label>
                                            <textarea class="form-control rounded ht-150" asp-for="OnlineExpert.Biographi" placeholder="برای معرفی خود به مشتری بیوگرافی بنویسید... "></textarea>
                                        </div>
                                    </div>

                                    <!-- ✅ Save Changes Button -->
                                    <div class="row align-items-center justify-content-center">
                                        <div class="col-xl-7 col-lg-10 col-md-12">
                                            <div class="bg-white rounded p-1">
                                                <div class="form-group mb-0 position-relative">
                                                    <button asp-page-handler="update"  class="btn full-width btn-height text-white fs-md" type="submit" style="background:#03343b">ذخیره تغییرات</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <input type="hidden" asp-for="OnlineExpert.SelectedHouseWorkIds" />
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            let $select = $('.js-example-basic-multiple');

            $select.select2({
                placeholder: "مهارت‌های خود را انتخاب کنید",
                allowClear: true,
                width: '100%'
            });

            $('form').submit(function () {
                let selectedValues = $select.val();
                $('<input>').attr({
                    type: 'hidden',
                    name: 'houseWorkIds',
                    value: selectedValues
                }).appendTo('form');
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            let maxChanges = 3;
            let skillChangeCount = @Model.SkillUpdateCount;
            let lastUpdateTime = new Date("@(Model.LastSkillUpdate?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? "")");
            let cooldownHours = 12;
            let cooldownMilliseconds = cooldownHours * 60 * 60 * 1000;
            let currentTime = new Date();

            if (skillChangeCount >= maxChanges && (currentTime - lastUpdateTime) < cooldownMilliseconds) {
                alert("شما بیش از حد مجاز مهارت‌های خود را تغییر داده‌اید. لطفا " + cooldownHours + " ساعت صبر کنید.");
                $('form').submit(function (e) { e.preventDefault(); });
            }

            let isSubmitting = false;
            $('form').submit(function (e) {
                if (isSubmitting) {
                    e.preventDefault();
                    return false;
                }
                isSubmitting = true;
                setTimeout(() => isSubmitting = false, 5000); // Prevents spam-clicking for 5 seconds
            });
        });
    </script>


}