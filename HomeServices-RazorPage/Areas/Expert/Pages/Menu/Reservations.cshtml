@page
@using App.Domain.Core.Enum
@using Framework
@using App.Domain.Core.Helpers
@model HomeServices_RazorPage.Areas.Expert.Pages.Menu.ReservationsModel
@{
}
<div class="goodup-dashboard-wrap gray px-4 py-5">
    <a class="mobNavigation" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="MobNav">
        <i class="fas fa-bars ms-2"></i>منو
    </a>
    <div class="collapse" id="MobNav">
        <div class="goodup-dashboard-nav sticky-top">
            <div class="goodup-dashboard-inner">
                <ul data-submenu-title="منو">
                    <li><a asp-page="Dashboard"><i class="lni lni-dashboard ms-2"></i>داشبورد</a></li>
                    <li><a asp-page="reservations"><i class="lni lni-files ms-2"></i>سفارش های رزرو</a></li>
                    <li><a asp-page="Comments"><i class="lni lni-envelope ms-2"></i> نظرات کاربران</a></li>
                </ul>
                <ul data-submenu-title="حساب کاربری">
                    <li><a asp-page="Profile"><i class="lni lni-user ms-2"></i> تنظیمات </a></li>
                    <li><a asp-page="/logout" asp-area=""><i class="lni lni-power-switch ms-2"></i>خروج</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="goodup-dashboard-content">
        <div class="dashboard-tlbar d-block mb-5">
            <div class="row">
                <div class="colxl-12 col-lg-12 col-md-12">
                    <h1 class="ft-medium fs-lg">لیست رزروها</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item text-muted"><a href="#">خانه</a></li>
                            <li class="breadcrumb-item text-muted"><a href="#">داشبورد</a></li>
                            <li class="breadcrumb-item"><a href="#" class="theme-cl">لیست رزروها</a></li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>


        <div class="col-lg-12">
            <div class="portlet box shadow">
                <div class="portlet-heading">
                </div><!-- /.portlet-heading -->
                <div class="portlet-body">
                    <div class="top-buttons-box mb-2">
                    </div>
                    <div class="dashboard-list-wraps-head br-bottom py-3 px-3">
                        <div class="dashboard-list-wraps-flx">
                            <h4 class="mb-0 ft-medium fs-md"><i class="fas fa-shopping-basket ms-2 theme-cl fs-sm"></i>لیست رزروها</h4>
                        </div>
                    </div>
                    <div class="row">
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-striped" id="data-table" style="font-size: 14px;">
                                <thead>
                                    <tr>
                                        <th class="p-low" style="padding: 8px;"><input type="checkbox" id="btn-check-all-toggle"></th>
                                        <th style="padding: 8px;">سفارش دهنده</th>
                                        <th style="padding: 8px;">عنوان خدمت</th>
                                        <th style="padding: 8px;">تاریخ اجرا</th>
                                        <th style="padding: 8px;">وضعیت</th>
                                        <th style="padding: 8px;">عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.OrderDtos != null && Model.OrderDtos.Any())
                                    {
                                        @foreach (var order in Model.OrderDtos)
                                        {
                                            <tr>
                                                <td style="padding: 8px;"><input type="checkbox"></td>
                                                <td>
                                                    <div class="ground ground-list-single">
                                                        <a asp-page="/menu/content" asp-area="customer" asp-route-customerId="@order.CustomerId">
                                                            <img class="ground-avatar"
                                                                 src="@(string.IsNullOrEmpty(order.ImagePath) ? Url.Content("~/images/profiles/base (3).png") : order.ImagePath)"
                                                                 alt="Profile Image">
                                                            @order.CustomerName
                                                            <span class="profile-status bg-offline pull-right"></span>
                                                        </a>
                                                    </div>
                                                </td>

                                                <td style="padding: 8px;">@order.HouseWork</td>
                                                <td style="padding: 8px;">@order.CompletionDate.ToPersianString()</td>
                                                <td style="padding: 8px;">@order.StausService.GetDisplayName()</td>
                                                <td>
                                                    <div class="d-flex justify-content-center align-items-center">
                                                        <a asp-page="orders" asp-route-id="@order.Id" class="btn btn-primary btn-sm">
                                                            <i class="fas fa-eye ms-1"></i>مشاهده
                                                        </a>
                                                    </div>
                                                    @if (order.StausService == StausServiceEnum.WaitingForService)
                                                    {
                                                        <div class="d-flex justify-content-center align-items-center">
                                                            <form method="post" asp-page-handler="Change" asp-route-id="@order.Id">
                                                                <button type="submit" class="btn btn-success btn-sm">
                                                                    <i class="fas fa-check-circle ms-1"></i>اتمام کار
                                                                </button>
                                                            </form>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }else{
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <div class="alert alert-warning">
                                                سفارشی برای مهارت های شما وجود ندارد
                                            </div>
                                        </td>
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div><!-- /.portlet-body -->
            </div><!-- /.portlet -->
        </div><!-- /.col-lg-12 -->
    </div>
</div>
