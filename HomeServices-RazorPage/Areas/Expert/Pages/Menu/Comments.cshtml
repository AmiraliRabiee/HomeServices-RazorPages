@page
@using Framework
@model HomeServices_RazorPage.Areas.Expert.Pages.Menu.CommentsModel
@* @using App.Domain.Core.Helpers
@{
    int id = UserTools.GetExpertId(User.Claims);
} *@
<section class="gray">
    <div class="goodup-dashboard-wrap gray px-4 py-5">
        <div class="container-fluid">
            <div class="row">
                <!-- Sidebar (for Experts) -->
                @if (User.IsInRole("Expert"))
                {
                    <div class="col-lg-3 col-md-4">
                        <div class="goodup-dashboard-nav sticky-top">
                            <div class="goodup-dashboard-inner">
                                <ul data-submenu-title="منو">
                                    <li><a asp-page="Dashboard"><i class="lni lni-dashboard ms-2"></i>داشبورد</a></li>
                                    <li><a asp-page="reservations"><i class="lni lni-files ms-2"></i>سفارش های رزرو</a></li>
                                    <li><a asp-page="accepted"><i class="lni lni-files ms-2"></i>سفارش های فعال</a></li>

                                    <li><a asp-page="Comments"><i class="lni lni-envelope ms-2"></i> نظرات کاربران</a></li>
                                </ul>
                                <ul data-submenu-title="حساب کاربری">
                                    <li><a asp-page="Profile"><i class="lni lni-user ms-2"></i> تنظیمات </a></li>
                                    <li><a asp-page="/logout" asp-area=""><i class="lni lni-power-switch ms-2"></i>خروج</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }

                <!-- Main Content (Comments & Sidebar Together for Non-Experts) -->
                <div class="@(User.IsInRole("Expert") ? "col-lg-9 col-md-8" : "col-lg-12")">
                    <div class="d-flex flex-column flex-lg-row gap-4">
                        @if (!User.IsInRole("Expert"))
                        {
                            <!-- Profile Box (Left Side for Non-Experts) -->
                            <div class="col-lg-4">
                                <div class="author-wrap-ngh">
                                    <div class="author-wrap-head-ngh">
                                        <div class="author-wrap-ngh-thumb">
                                            <img src="@Model.ExpertDto.ImagePath" class="img-fluid circle" alt="">
                                        </div>
                                        <div class="author-wrap-ngh-info">
                                            <h5>@Model.ExpertDto.FullName</h5>
                                        </div>
                                    </div>

                                    <div class="author-wrap-caption-ngh">
                                        <div class="author-wrap-jhyu-ngh">
                                            <ul>
                                                <li>
                                                    <div class="gdup-kvty">
                                                        <div class="gdup-kvty-icon bg-light-sky text-sky"><i class="fas fa-file"></i></div>
                                                        <div class="gdup-kvty-ctr"><h6 class="count">@Model.DoneSuggestions</h6></div>
                                                        <div class="gdup-kvty-text">خدمات انجام شده</div>
                                                    </div>
                                                </li>
                                                <li>
                                                    <div class="gdup-kvty">
                                                        <div class="gdup-kvty-icon bg-light-warning text-warning"><i class="fas fa-thumbs-up"></i></div>
                                                        <div class="gdup-kvty-ctr"><h6 class="count">@Model.AverageScore</h6></div>
                                                        <div class="gdup-kvty-text">میانگین امتیاز</div>
                                                    </div>
                                                </li>
                                                <li>
                                                    <div class="gdup-kvty">
                                                        <div class="gdup-kvty-icon bg-light-danger text-danger"><i class="fas fa-heart"></i></div>
                                                        <div class="gdup-kvty-ctr"><h6 class="count">@Model.CommentCount</h6></div>
                                                        <div class="gdup-kvty-text">تعداد نظرات</div>
                                                    </div>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="author-wrap-yuio-ngh mt-5">
                                            <div class="row g-4">
                                                <div class="col-6">
                                                    <a asp-page="/menu/dashboard" asp-area="customer" class="adv-btn full-width">داشبورد</a>
                                                </div>
                                                <div class="col-6">
                                                    <a asp-page="/addcomment/index" asp-area="" asp-route-id="@Model.ExpertDetails.SuggestionId" class="adv-btn full-width">ثبت نظر</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Comments Section -->
                        <div class="col">
                            <div class="goodup-dashboard-content">
                                <div class="dashboard-tlbar d-block mb-5">
                                    <h1 class="ft-medium fs-lg">نظرات کاربران</h1>
                                </div>
                                <div class="col-xl-12 col-lg-12 col-md-12">
                                    <div class="_dashboard_content bg-white rounded mb-4">
                                        <div class="_dashboard_content_body">
                                            @if (Model.Comments != null && Model.Comments.Any())
                                            {
                                                @foreach (var comment in Model.Comments)
                                                {
                                                    <div class="reviews-comments-item border p-3 mb-3 rounded">
                                                        <div class="row">
                                                            <div class="col">
                                                                <div class="reviews-comments-item-text">
                                                                    <h4>
                                                                        @comment.CustomerName
                                                                        <span class="reviews-comments-item-date d-flex align-items-center ms-2">
                                                                            <i class="ti-calendar theme-cl ms-1"></i>@comment.RegissterDate.ToPersianString()
                                                                        </span>
                                                                    </h4>
                                                                    <div class="rating-stars">
                                                                        @for (int i = 1; i <= 5; i++)
                                                                        {
                                                                            <span class="star @(i <= comment.Points ? "filled" : "")">&#9733;</span>
                                                                        }
                                                                    </div>
                                                                    <p>@comment.Opinion</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }else{
                                                <div class="alert alert-warning">
                                                    نظری وجود ندارد
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> <!-- End Comments Section -->
                </div>
            </div> <!-- End Main Content -->
        </div>
    </div>
</section>

<style>
    .rating-stars {
        display: flex;
        gap: 5px;
    }

    .star {
        font-size: 24px;
        color: #ddd;
    }

        .star.filled {
            color: gold;
        }

    .reviews-comments-item {
        background: #f9f9f9;
        border-left: 4px solid #007bff;
    }
</style>
