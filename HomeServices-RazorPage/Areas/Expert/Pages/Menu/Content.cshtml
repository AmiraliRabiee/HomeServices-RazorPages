@page
@model HomeServices_RazorPage.Areas.Expert.Pages.Menu.ContentModel
@{
}
<section class="gray">
    <div class="container">
        <div class="row">
            <!-- Profile Box (Left Side) -->
            <div class="col-xl-4 col-lg-4 col-md-12">
                <div class="author-wrap-ngh">
                    <div class="author-wrap-head-ngh">
                        <div class="author-wrap-ngh-thumb">
                            <img src="@(string.IsNullOrEmpty(Model.Expert.ImagePath) ? Url.Content("~/images/profiles/base (3).png") : Model.Expert.ImagePath)" class="img-fluid circle" alt="">
                        </div>
                        <div class="author-wrap-ngh-info">
                            <h5>@Model.Expert.FullName</h5>
                        </div>
                    </div>

                    <div class="author-wrap-caption-ngh">
                        <div class="author-wrap-jhyu-ngh">
                            <ul>
                                <li>
                                    <div class="gdup-kvty">
                                        <div class="gdup-kvty-icon bg-light-sky text-sky"><i class="fas fa-file"></i></div>
                                        <div class="gdup-kvty-ctr"><h6 class="count">@Model.DoneSuggestions</h6></div>
                                        <div class="gdup-kvty-text">خدمات انجام شده</div>
                                    </div>
                                </li>
                                <li>
                                    <div class="gdup-kvty">
                                        <div class="gdup-kvty-icon bg-light-warning text-warning"><i class="fas fa-thumbs-up"></i></div>
                                        <div class="gdup-kvty-ctr"><h6 class="count">@Model.AverageScore</h6><span></span></div>
                                        <div class="gdup-kvty-text">میانگین امتیاز</div>
                                    </div>
                                </li>
                                <li>
                                    <div class="gdup-kvty">
                                        <div class="gdup-kvty-icon bg-light-danger text-danger"><i class="fas fa-heart"></i></div>
                                        <div class="gdup-kvty-ctr"><h6 class="count">@Model.CommentCount</h6></div>
                                        <div class="gdup-kvty-text">تعداد نظرات</div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="author-wrap-yuio-ngh mt-5">
                            <div class="row g-4">
                                <div class="col-6">
                                    <a asp-page="/menu/comments" asp-area="expert" asp-route-expertId="@Model.Expert.Id" class="adv-btn full-width">خواندن نظرات</a>
                                </div>
                                <div class="col-6">
                                    <a asp-page="/addcomment/index" asp-area="" asp-route-id="@Model.Expert.SuggestionId" class="adv-btn full-width">ثبت نظر</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Personal Information Form (Right Side) -->
            <div class="col-xl-8 col-lg-8 col-md-12">
                <form class="submit-form">
                    <div class="dashboard-list-wraps bg-white rounded mb-4">
                        <div class="dashboard-list-wraps-head br-bottom py-3 px-3">
                            <div class="dashboard-list-wraps-flx">
                                <h4 class="mb-0 ft-medium fs-md"><i class="fa fa-user-check ms-2 theme-cl fs-sm"></i>مشخصات </h4>
                            </div>
                        </div>

                        <div class="dashboard-list-wraps-body py-3 px-3">
                            <div class="row">
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                    <div class="form-group">
                                        <label class="mb-1">نام و نام خانوادگی</label>
                                        <input type="text" class="form-control rounded" asp-for="@Model.Expert.FullName" readonly />
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                    <div class="form-group">
                                        <label class="mb-1">شهر</label>
                                        <input type="text" class="form-control rounded" asp-for="Expert.CityName" readonly />
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                    <div class="form-group">
                                        <label class="mb-1">شماره موبایل</label>
                                        <input type="text" class="form-control rounded" asp-for="Expert.PhoneNumber" readonly />
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                    <div class="form-group">
                                        <label class="mb-1">مهارت ها</label>
                                        <div class="form-control rounded overflow-auto" style="height: 38px; white-space: nowrap;">
                                            @foreach (var skill in Model.Skills)
                                            {
                                                <span class="badge bg-primary me-1">@skill.HouseWorkName</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                    <div class="form-group">
                                        <label class="mb-1">بیوگرافی</label>
                                        <textarea class="form-control rounded ht-150">@Model.Expert.Biographi</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>